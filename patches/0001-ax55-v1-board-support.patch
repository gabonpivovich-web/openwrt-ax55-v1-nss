diff --git a/package/nss/nss-tools/files/nss-dwmac.defaults b/package/nss/nss-tools/files/nss-dwmac.defaults
index 782a0d13be..82ca875486 100644
--- a/package/nss/nss-tools/files/nss-dwmac.defaults
+++ b/package/nss/nss-tools/files/nss-dwmac.defaults
@@ -54,6 +54,16 @@ nss_dwmac_board_defaults() {
 		switch_args='cpu_port=6 ports=0x7e wake_phys=90000.mdio-1:00,90000.mdio-1:01,90000.mdio-1:02,90000.mdio-1:03,90000.mdio-1:04'
 		vtu='1:6t,1u,2u,3u,4u;2:6t,5u'
 		;;
+	tplink,archer-ax55-v1)
+		# port 6 = CPU (2500base-x), 0 = wan, 1-4 = lan. An
+		# RTL8367S-VB, so rtl8367s-nss re-arms it and carries its own
+		# VLAN and PVID program - switch_args and vtu stay empty.
+		fw_mask='0x2'
+		trunk='eth0'
+		fabric='none'
+		switch_args=''
+		vtu=''
+		;;
 	xunison,exigo-hub-d50-5g)
 		# WAN is GMAC0's own GE PHY (netdev 'wan'), so GMAC1 - the switch
 		# trunk - comes up as eth1 and carries LAN only: port 0 = CPU
diff --git a/target/linux/qualcommax/dts/ipq5018-archer-ax55-v1.dts b/target/linux/qualcommax/dts/ipq5018-archer-ax55-v1.dts
index 4f67177867..2f6fa27ef1 100644
--- a/target/linux/qualcommax/dts/ipq5018-archer-ax55-v1.dts
+++ b/target/linux/qualcommax/dts/ipq5018-archer-ax55-v1.dts
@@ -294,9 +294,18 @@
 
 	phy-mode = "2500base-x";
 
+	/*
+	 * The trunk is a speed step: 2.5G here, 1G on every front port, so
+	 * the switch sends pause frames when a front port's egress queue
+	 * fills. Without this phylink resolves the link as pauseless,
+	 * dwmac1000_flow_ctrl() never sets GMAC_FLOW_CTRL_RFE, the MAC
+	 * discards them, and the switch drops ~13% of a 400 Mbit/s stream
+	 * with every NSS counter clean.
+	 */
 	fixed-link {
 		speed = <2500>;
 		full-duplex;
+		pause;
 	};
 };
 
@@ -398,6 +407,7 @@
 				fixed-link {
 					speed = <2500>;
 					full-duplex;
+					pause;
 				};
 			};
 		};
@@ -442,7 +452,7 @@
 	status = "okay";
 
 	qcom,rproc = <&q6_wcss_pd1>;
-	qcom,ath11k-fw-memory-mode = <1>;
+	qcom,ath11k-fw-memory-mode = <2>;
 	qcom,ath11k-calibration-variant = "TP-Link-Archer-AX55-v1";
 	qcom,bdf-addr = <0x4c400000>;
 };
@@ -452,7 +462,7 @@
 
 	qcom,rproc = <&q6_wcss_pd3>;
 	qcom,userpd-subsys-name = "q6v5_wcss_userpd3";
-	qcom,ath11k-fw-memory-mode = <1>;
+	qcom,ath11k-fw-memory-mode = <2>;
 	qcom,ath11k-calibration-variant = "TP-Link-Archer-AX55-v1";
 	qcom,bdf-addr = <0x4d100000>;
 	qcom,m3-dump-addr = <0x4df00000>;
