diff --git a/target/linux/qualcommax/ipq50xx/base-files/etc/board.d/01_leds b/target/linux/qualcommax/ipq50xx/base-files/etc/board.d/01_leds
index 0d30aa35c3..43acd8f09c 100644
--- a/target/linux/qualcommax/ipq50xx/base-files/etc/board.d/01_leds
+++ b/target/linux/qualcommax/ipq50xx/base-files/etc/board.d/01_leds
@@ -28,8 +28,11 @@ linksys,mr5500)
 	ucidef_set_led_netdev "wan-port-activity" "WAN-PORT-ACTIVITY" "90000.mdio-1:04:amber:wan" "wan" "tx rx"
 	;;
 tplink,archer-ax55-v1)
+	# There are no DSA user ports left to key on once rtl8367s-nss has
+	# re-armed the switch, so LAN follows the bridge and WAN the VLAN
+	# that rides the trunk; a netdev named 'wan' does not exist here.
 	ucidef_set_led_netdev "lan" "LAN" "green:lan" "br-lan"
-	ucidef_set_led_netdev "wan" "WAN" "green:wan-online" "wan"
+	ucidef_set_led_netdev "wan" "WAN" "orange:wan" "eth0.2" "tx rx"
 	ucidef_set_led_netdev "wlan2g" "WLAN2G" "green:wlan-2ghz" "phy0-ap0" "link tx rx"
 	ucidef_set_led_netdev "wlan5g" "WLAN5G" "green:wlan-5ghz" "phy1-ap0" "link tx rx"
 	;;
